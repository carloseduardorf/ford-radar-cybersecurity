# ─────────────────────────────────────────────────────────────────────
# Challenger Ford — Variáveis de ambiente (template, NUNCA commitar .env)
# ─────────────────────────────────────────────────────────────────────

# Ambiente de execução (controla error verbosity, debug, etc.)
APP_ENV=development              # development | staging | production
APP_NAME="Ford Radar Competitivo"
APP_VERSION=1.0.0

# Porta e host
APP_HOST=0.0.0.0
APP_PORT=8000

# ─── Banco de dados ──────────────────────────────────────────────────
# Em produção use Postgres com TLS: postgresql+psycopg://user:pwd@host:5432/db?sslmode=require
DATABASE_URL=sqlite+aiosqlite:///./challenge.db

# ─── Criptografia em repouso (AES-GCM 256) ───────────────────────────
# 32 bytes em base64. Gere com:
#   python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=

# ─── Pseudonimização (HMAC-SHA256) ───────────────────────────────────
# Sal independente da chave de cripto, para evitar reverso por correlação
PSEUDONYM_SALT=

# ─── JWT ─────────────────────────────────────────────────────────────
# Mínimo 64 chars. Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
JWT_ISSUER=ford-radar
JWT_AUDIENCE=ford-radar-clients

# ─── HMAC para webhooks (n8n -> /ingest) ─────────────────────────────
WEBHOOK_HMAC_SECRET=
WEBHOOK_TIMESTAMP_TOLERANCE_SEC=300

# ─── CORS — domínios autorizados (separados por vírgula) ─────────────
CORS_ALLOWED_ORIGINS=https://radar.ford.local,http://localhost:3000,http://localhost:19006

# ─── Rate limit (default global) ─────────────────────────────────────
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_INGEST=30/minute

# ─── Limites de payload ──────────────────────────────────────────────
MAX_REQUEST_BYTES=2097152            # 2 MiB para JSON normal
MAX_UPLOAD_BYTES=20971520            # 20 MiB para upload de planilha
MAX_STRING_LENGTH=512                # Limite default de strings em schemas

# ─── Política de retenção (LGPD) ─────────────────────────────────────
RETENTION_AUDIT_DAYS=365
RETENTION_RAW_SPREADSHEETS_DAYS=180
RETENTION_USER_INACTIVE_DAYS=730

# ─── HTTPS ───────────────────────────────────────────────────────────
FORCE_HTTPS=true                     # 308 redirect quando true
HSTS_MAX_AGE=63072000                # 2 anos

# ─── Conta admin de bootstrap (apenas first-run) ─────────────────────
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
